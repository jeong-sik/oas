      "id": "oas.runtime_protocol.v2",
      "kind": "runtime_protocol",
      "owner": "OAS",
      "producer": "Runtime server",
      "consumer": ["oas_runtime subprocess clients"],
      "wire_or_artifact": "Runtime.protocol_message over NDJSON stdio",
